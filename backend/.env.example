# Copy this file to .env and fill it in.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medin

# Generate your own with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Set to true in production (HTTPS only cookies).
COOKIE_SECURE=false

# Invite links point here. Create one with: python -m scripts.create_invite
FRONTEND_URL=http://localhost:3000

# Optional: image uploads (https://cloudinary.com). Uploads are disabled when empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
